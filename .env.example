# Base de datos PostgreSQL (la app usa siempre esta; en Neon, la URL del pooler)
DATABASE_URL="postgresql://USUARIO@localhost:5432/ediadmi_dev"
# Opcional: conexión directa para las migraciones (en Neon, la URL sin "-pooler")
DIRECT_URL=""
# Base usada por los tests e2e (se recrea con el seed)
DATABASE_URL_TEST="postgresql://USUARIO@localhost:5432/ediadmi_test"

# Better Auth: secreto aleatorio de al menos 32 caracteres (openssl rand -base64 32)
BETTER_AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
# URL pública de la app (en producción, la del dominio: https://…)
BETTER_AUTH_URL="http://localhost:3000"

# Nombre del complejo que se muestra en la cabecera, los mails y el PDF
EDIFICIO_NOMBRE="Complejo"

# Mail: "archivo" (desarrollo: guarda los mails en storage/mails), "smtp" (Gmail; en Vercel es
# el valor por defecto), "resend" (dominio propio verificado) o "ninguno".
# A los mails ficticios (@example.com) nunca se les manda nada.
MAIL_DRIVER="archivo"
# Nombre que ve quien recibe (con Gmail, la dirección es siempre la de SMTP_USER)
MAIL_FROM="Administración <no-responder@example.com>"
# Gmail: la cuenta y una "contraseña de aplicación" (Cuenta de Google → Seguridad →
# Verificación en dos pasos → Contraseñas de aplicaciones). No es la clave de la cuenta.
SMTP_USER=""
SMTP_PASS=""
# Opcionales (por defecto smtp.gmail.com y 465)
SMTP_HOST=""
SMTP_PORT=""
RESEND_API_KEY=""

# Contraseña de los usuarios de prueba que crea el seed (solo desarrollo, nunca en producción)
SEED_PASSWORD="cambiar-esta-clave-123"

# Secreto del cron diario que revisa el vencimiento del seguro (/api/cron/seguro).
# En Vercel, el cron de vercel.json lo manda solo si la variable existe.
CRON_SECRET=""
