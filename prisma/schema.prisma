// Esquema de datos. Las tablas user/session/account/verification siguen el
// esquema de Better Auth (nombres en inglés por convención de la librería).
// El resto del dominio está en español.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticación (Better Auth)
// ---------------------------------------------------------------------------

enum Rol {
  ADMINISTRACION
  COMISION
  PORTERIA
  UNIDAD
}

model User {
  id                    String            @id
  name                  String
  email                 String            @unique
  emailVerified         Boolean           @default(false)
  image                 String?
  rol                   Rol               @default(UNIDAD)
  activo                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  sessions              Session[]
  accounts              Account[]
  personas              Persona[]
  auditorias            Auditoria[]
  solicitudes           Solicitud[]
  eventos               SolicitudEvento[]
  comunicados           Comunicado[]
  consentimientos       Contacto[]        @relation("ConsentimientoRegistradoPor")
  reservas              Reserva[]         @relation("ReservaCreadaPor")
  cancelaciones         Reserva[]         @relation("ReservaCanceladaPor")
  emergencias           Emergencia[]      @relation("EmergenciaAutor")
  emergenciasCerradas   Emergencia[]      @relation("EmergenciaCerradaPor")
  emergenciasDifundidas Emergencia[]      @relation("EmergenciaDifundidaPor")
  pedidosResueltos      PedidoAcceso[]    @relation("PedidoAccesoResueltoPor")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Edificio
// ---------------------------------------------------------------------------

enum TipoTorre {
  TORRE
  SECTOR // ej. gestión de garajes
}

enum TipoUnidad {
  APTO
  LOCAL
  GARAJE
  OFICINA
}

enum Calidad {
  PROPIETARIO
  PROMITENTE
  INQUILINO
}

/// Torre o sector. `codigo` es el identificador que va en el código de unidad (2, 3, 4, 5…).
model Torre {
  /// Clave interna. El número que ve la gente ("2" en 2-201) es `numero`.
  codigo     Int       @id @default(autoincrement())
  edificioId String
  edificio   Edificio  @relation(fields: [edificioId], references: [id])
  numero     Int
  nombre     String
  /// Color de marca de la torre (docs/design.md); vacío = gris.
  color      String    @default("")
  tipo       TipoTorre @default(TORRE)
  orden      Int       @default(0)
  unidades   Unidad[]
  espacios   Espacio[]

  @@unique([edificioId, numero])
  @@unique([edificioId, nombre])
  @@map("torre")
}

model Unidad {
  id              String              @id @default(cuid())
  edificioId      String
  edificio        Edificio            @relation(fields: [edificioId], references: [id])
  torreId         Int
  torre           Torre               @relation(fields: [torreId], references: [codigo])
  numero          String
  tipo            TipoUnidad          @default(APTO)
  etiqueta        String?
  arrendada       Boolean             @default(false)
  activa          Boolean             @default(true)
  // Cuotas mensuales fijas (centésimos). Se arrastran de mes a mes hasta que
  // Administración las cambie (docs/PLAN.md, decisión 5).
  gcUnidad        Int                 @default(0) // gasto común ordinario (lo paga A, o I si está alquilada)
  gcPropietario   Int                 @default(0) // parte de cargo del propietario, ej. seguro (A o P)
  gcGaraje        Int                 @default(0)
  cuotaExtraFr    Int                 @default(0) // cuota extra del fondo de reserva (A o P); 0 si no se usa
  garajeACargoDe  ACargoDe            @default(INQUILINO)
  personas        Persona[]
  destinatarios   DestinatarioExtra[]
  lineas          LineaLiquidacion[]
  ingresos        Ingreso[]
  cargos          CargoExtra[]
  saldosIniciales SaldoInicial[]
  solicitudes     Solicitud[]
  reservas        Reserva[]
  emergencias     Emergencia[]
  pedidosAcceso   PedidoAcceso[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([torreId, numero])
  @@index([edificioId])
  @@map("unidad")
}

/// Responsable de una unidad. Un usuario puede estar vinculado a varias personas
/// (ej. dueño de un apartamento y de un garaje).
model Persona {
  id                 String    @id @default(cuid())
  unidadId           String
  unidad             Unidad    @relation(fields: [unidadId], references: [id])
  calidad            Calidad
  nombre             String
  telefono           String
  email              String
  userId             String?
  user               User?     @relation(fields: [userId], references: [id])
  activa             Boolean   @default(true)
  altaEn             DateTime  @default(now())
  bajaEn             DateTime?
  /// Cuándo el responsable revisó y confirmó sus datos (y si la unidad está arrendada).
  datosConfirmadosEn DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([unidadId, activa])
  @@index([userId])
  @@map("persona")
}

/// Mails extra que reciben liquidaciones y comunicados de una unidad
/// (ej. copropietarios), sin usuario en el sistema.
model DestinatarioExtra {
  id        String   @id @default(cuid())
  unidadId  String
  unidad    Unidad   @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  nombre    String?
  email     String
  createdAt DateTime @default(now())

  @@unique([unidadId, email])
  @@map("destinatario_extra")
}

// ---------------------------------------------------------------------------
// Auditoría de acciones sensibles
// ---------------------------------------------------------------------------

model Auditoria {
  id         String   @id @default(cuid())
  fecha      DateTime @default(now())
  usuarioId  String?
  usuario    User?    @relation(fields: [usuarioId], references: [id])
  /// Edificio en el que pasó (null: acciones del sistema, ej. alta de un edificio).
  edificioId String?
  accion     String
  entidad    String
  entidadId  String?
  detalle    Json?
  ip         String?

  @@index([entidad, entidadId])
  @@index([fecha])
  @@index([edificioId])
  @@map("auditoria")
}

// ---------------------------------------------------------------------------
// Liquidación de gastos comunes. Todos los montos son Int en centésimos.
// ---------------------------------------------------------------------------

enum ACargoDe {
  PROPIETARIO
  INQUILINO
}

enum Sufijo {
  A
  P
  I
}

enum EstadoLiquidacion {
  BORRADOR
  PUBLICADA
  ANULADA
}

enum OrigenIngreso {
  MANUAL
  EXCEL
  DEPOSITO // depósito no identificado que se asignó a la unidad
}

enum TipoCargo {
  BARBACOAS
  OTROS // tag de garaje, ajustes y bonificaciones (admite negativos)
  MULTA
}

enum TipoImportacion {
  INGRESOS
  SALDOS_INICIALES
  EGRESOS
}

enum EstadoImportacion {
  PENDIENTE
  CONFIRMADA
  DESCARTADA
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADO
  ERROR
}

/**
 * Parámetros generales (una sola fila, id = 1).
 */
model Configuracion {
  edificioId         String   @id
  edificio           Edificio @relation(fields: [edificioId], references: [id])
  direccion          String   @default("")
  tasaInteresPb      Int      @default(100) // puntos básicos: 100 = 1 %
  tasaFondoReservaPb Int      @default(500) // 500 = 5 %
  diaVencimiento     Int      @default(25)
  procedimientoPago  String   @default("")
  /// Número de WhatsApp de la Administración (decisión 19), solo dígitos con código de país: 598…
  whatsapp           String   @default("")

  @@map("configuracion")
}

model Liquidacion {
  id                     String                   @id @default(cuid())
  edificioId             String
  edificio               Edificio                 @relation(fields: [edificioId], references: [id])
  periodo                String // "AAAA-MM"
  estado                 EstadoLiquidacion        @default(BORRADOR)
  tasaInteresPb          Int
  tasaFondoReservaPb     Int
  diaVencimiento         Int
  procedimientoPago      String
  disponibilidades       Json?
  rectificaId            String?                  @unique
  rectifica              Liquidacion?             @relation("Rectificacion", fields: [rectificaId], references: [id])
  rectificadaPor         Liquidacion?             @relation("Rectificacion")
  publicadaEn            DateTime?
  publicadaPorId         String?
  anuladaEn              DateTime?
  anuladaPorId           String?
  motivoAnulacion        String?
  pdfId                  String?                  @unique
  pdf                    Archivo?                 @relation(fields: [pdfId], references: [id])
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  lineas                 LineaLiquidacion[]
  ingresos               Ingreso[]
  egresos                Egreso[]
  cargos                 CargoExtra[]
  saldosIniciales        SaldoInicial[]
  importaciones          Importacion[]
  depositosCargados      DepositoNoIdentificado[] @relation("DepositoCargado")
  depositosIdentificados DepositoNoIdentificado[] @relation("DepositoIdentificado")

  // Índices únicos parciales (en la migración): un solo período no anulado y
  // un solo borrador a la vez.
  @@index([periodo, estado])
  @@map("liquidacion")
}

/**
 * Foto de cada línea al publicar (lo que figura en el PDF).
 */
model LineaLiquidacion {
  id            String      @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  unidadId      String
  unidad        Unidad      @relation(fields: [unidadId], references: [id])
  sufijo        Sufijo
  codigo        String
  descripcion   String
  orden         Int
  saldoAnterior Int
  pagos         Int
  saldo         Int
  intereses     Int
  gcUnidad      Int
  gcGaraje      Int
  fondoReserva  Int
  cuotaExtraFr  Int         @default(0)
  barbacoas     Int         @default(0)
  otros         Int         @default(0)
  multas        Int
  saldoAPagar   Int

  @@unique([liquidacionId, unidadId, sufijo])
  @@index([unidadId])
  @@map("linea_liquidacion")
}

/**
 * Saldo anterior de la primera liquidación (no hay una anterior de donde tomarlo).
 */
model SaldoInicial {
  id            String      @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  unidadId      String
  unidad        Unidad      @relation(fields: [unidadId], references: [id])
  sufijo        Sufijo
  monto         Int

  @@unique([liquidacionId, unidadId, sufijo])
  @@map("saldo_inicial")
}

model Ingreso {
  id            String                  @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion             @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  unidadId      String
  unidad        Unidad                  @relation(fields: [unidadId], references: [id])
  sufijo        Sufijo
  fecha         DateTime                @db.Date
  monto         Int
  referencia    String?
  origen        OrigenIngreso
  importacionId String?
  importacion   Importacion?            @relation(fields: [importacionId], references: [id])
  deposito      DepositoNoIdentificado?
  creadoPorId   String?
  createdAt     DateTime                @default(now())

  @@index([liquidacionId])
  @@map("ingreso")
}

/**
 * Planilla subida, con su vista previa, hasta que se confirma o descarta.
 */
model Importacion {
  id            String            @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion       @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  tipo          TipoImportacion
  archivoNombre String
  filas         Json
  errores       Int
  estado        EstadoImportacion @default(PENDIENTE)
  usuarioId     String?
  confirmadaEn  DateTime?
  createdAt     DateTime          @default(now())
  ingresos      Ingreso[]

  @@map("importacion")
}

model Rubro {
  id               String       @id @default(cuid())
  edificioId       String
  edificio         Edificio     @relation(fields: [edificioId], references: [id])
  codigo           String // "2.1", único por edificio
  nombre           String
  padreId          String?
  padre            Rubro?       @relation("Subrubros", fields: [padreId], references: [id])
  hijos            Rubro[]      @relation("Subrubros")
  cargoPropietario Boolean      @default(false) // ej. seguro: lo paga P, no I
  activo           Boolean      @default(true)
  orden            Int          @default(0)
  egresos          Egreso[]
  fijos            EgresoFijo[]

  @@unique([edificioId, codigo])
  @@map("rubro")
}

model Egreso {
  id            String      @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  rubroId       String
  rubro         Rubro       @relation(fields: [rubroId], references: [id])
  fecha         DateTime    @db.Date
  proveedor     String
  detalle       String // período o detalle ("Agosto 2026")
  monto         Int
  fijoId        String?
  fijo          EgresoFijo? @relation(fields: [fijoId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([liquidacionId])
  @@map("egreso")
}

/**
 * Egresos que se repiten todos los meses: se precargan al crear la liquidación.
 */
model EgresoFijo {
  id        String   @id @default(cuid())
  rubroId   String
  rubro     Rubro    @relation(fields: [rubroId], references: [id])
  proveedor String
  detalle   String
  monto     Int
  activo    Boolean  @default(true)
  egresos   Egreso[]

  @@map("egreso_fijo")
}

model CargoExtra {
  id            String      @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  unidadId      String
  unidad        Unidad      @relation(fields: [unidadId], references: [id])
  sufijo        Sufijo
  tipo          TipoCargo
  concepto      String
  monto         Int
  /// Reserva de barbacoa que originó el cargo (se copia al anular, como el resto del cargo).
  reservaId     String?
  reserva       Reserva?    @relation(fields: [reservaId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([liquidacionId])
  @@index([reservaId])
  @@map("cargo_extra")
}

model DepositoNoIdentificado {
  id               String       @id @default(cuid())
  fecha            DateTime     @db.Date
  forma            String // "Depósito", "Transferencia"
  documento        String?
  monto            Int
  cargadoEnId      String
  cargadoEn        Liquidacion  @relation("DepositoCargado", fields: [cargadoEnId], references: [id], onDelete: Cascade)
  identificadoEnId String?
  identificadoEn   Liquidacion? @relation("DepositoIdentificado", fields: [identificadoEnId], references: [id], onDelete: SetNull)
  ingresoId        String?      @unique
  ingreso          Ingreso?     @relation(fields: [ingresoId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  @@map("deposito_no_identificado")
}

model Archivo {
  id          String       @id @default(cuid())
  nombre      String
  tipo        String
  tamano      Int
  datos       Bytes
  createdAt   DateTime     @default(now())
  liquidacion Liquidacion?
  comunicado  Comunicado?
  solicitud   Solicitud?

  @@map("archivo")
}

/**
 * Bandeja de salida: cada mail de un envío masivo, con su estado (reintento manual).
 */
model EnvioMail {
  id           String      @id @default(cuid())
  tipo         String // "liquidacion"
  refId        String?
  destinatario String
  asunto       String
  estado       EstadoEnvio @default(PENDIENTE)
  error        String?
  intentos     Int         @default(0)
  enviadoEn    DateTime?
  createdAt    DateTime    @default(now())

  @@index([tipo, refId, estado])
  @@map("envio_mail")
}

// ---------------------------------------------------------------------------
// Solicitudes varias (y el aviso de venta de la Fase 4)
// ---------------------------------------------------------------------------

enum CategoriaSolicitud {
  DESPERFECTO
  CONSULTA_GC
  INQUIETUD
  VENTA_UNIDAD
}

enum OrigenSolicitud {
  UNIDAD
  PORTERIA_PROPIA
  PORTERIA_A_PEDIDO
}

enum EstadoSolicitud {
  NUEVA
  EN_CURSO
  RESUELTA
}

model Solicitud {
  id         String             @id @default(cuid())
  edificioId String
  edificio   Edificio           @relation(fields: [edificioId], references: [id])
  unidadId   String?
  unidad     Unidad?            @relation(fields: [unidadId], references: [id])
  autorId    String
  autor      User               @relation(fields: [autorId], references: [id])
  categoria  CategoriaSolicitud
  origen     OrigenSolicitud    @default(UNIDAD)
  /// Quién la pidió, cuando la carga Portería a pedido de una unidad.
  pedidaPor  String?
  /// Foto opcional (avisos de desperfectos), achicada en el navegador antes de subir.
  fotoId     String?            @unique
  foto       Archivo?           @relation(fields: [fotoId], references: [id])
  asunto     String
  texto      String
  estado     EstadoSolicitud    @default(NUEVA)
  creadaEn   DateTime           @default(now())
  resueltaEn DateTime?
  eventos    SolicitudEvento[]

  @@index([unidadId, categoria, estado])
  @@index([estado, creadaEn])
  @@index([edificioId])
  @@map("solicitud")
}

// ---------------------------------------------------------------------------
// Reserva de espacios comunes
// ---------------------------------------------------------------------------

enum TipoEspacio {
  BARBACOA
  SOLARIUM // atado a su barbacoa: no se reserva, está disponible si la barbacoa no está reservada
  LAUNDRY // informativo (funciona con tarjeta prepaga)
  OTRO
}

enum Turno {
  MEDIODIA // 11 a 17
  NOCHE // 19 a 02 del día siguiente
}

enum OrigenReserva {
  UNIDAD
  PORTERIA_A_PEDIDO
  ADMINISTRACION
}

enum EstadoReserva {
  ACTIVA
  CANCELADA
}

model Espacio {
  id          String      @id @default(cuid())
  edificioId  String
  edificio    Edificio    @relation(fields: [edificioId], references: [id])
  nombre      String
  tipo        TipoEspacio
  torreId     Int?
  torre       Torre?      @relation(fields: [torreId], references: [codigo])
  activo      Boolean     @default(true)
  orden       Int         @default(0)
  tarifa      Int         @default(0) // centésimos, por turno
  /// Reglas de reserva, validadas con Zod (dominio/reservas.ts): anticipación, máximo por unidad, horas para cancelar.
  reglas      Json?
  /// Texto informativo (ej. cómo funciona el laundry).
  descripcion String      @default("")
  barbacoaId  String?     @unique
  barbacoa    Espacio?    @relation("SolariumDeBarbacoa", fields: [barbacoaId], references: [id])
  solarium    Espacio?    @relation("SolariumDeBarbacoa")
  reservas    Reserva[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([edificioId, nombre])
  @@map("espacio")
}

model Reserva {
  id             String        @id @default(cuid())
  espacioId      String
  espacio        Espacio       @relation(fields: [espacioId], references: [id])
  fecha          DateTime      @db.Date
  turno          Turno
  unidadId       String
  unidad         Unidad        @relation(fields: [unidadId], references: [id])
  /// Línea de la liquidación a la que se cobra (A, P o I: la de quien reservó o la que eligió Portería).
  sufijo         Sufijo
  creadaPorId    String
  creadaPor      User          @relation("ReservaCreadaPor", fields: [creadaPorId], references: [id])
  origen         OrigenReserva
  /// Quién la pidió, cuando la carga Portería o Administración.
  pedidaPor      String?
  estado         EstadoReserva @default(ACTIVA)
  canceladaPorId String?
  canceladaPor   User?         @relation("ReservaCanceladaPor", fields: [canceladaPorId], references: [id])
  canceladaEn    DateTime?
  creadaEn       DateTime      @default(now())
  cargos         CargoExtra[]

  // Índice único parcial (en la migración): un solo turno ACTIVO por espacio y fecha.
  @@index([espacioId, fecha])
  @@index([unidadId, estado])
  @@map("reserva")
}

enum TipoEventoSolicitud {
  RESPUESTA // la ve quien hizo la solicitud y le llega por mail
  CAMBIO_ESTADO
  NOTA_INTERNA // solo Administración
}

model SolicitudEvento {
  id          String              @id @default(cuid())
  solicitudId String
  solicitud   Solicitud           @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User                @relation(fields: [autorId], references: [id])
  tipo        TipoEventoSolicitud
  texto       String
  fecha       DateTime            @default(now())

  @@index([solicitudId, fecha])
  @@map("solicitud_evento")
}

// ---------------------------------------------------------------------------
// Comunicados de la Administración
// ---------------------------------------------------------------------------

enum TipoComunicado {
  AVISO
  REGLAMENTO
  ACTA
}

model Comunicado {
  id             String         @id @default(cuid())
  edificioId     String
  edificio       Edificio       @relation(fields: [edificioId], references: [id])
  tipo           TipoComunicado
  titulo         String
  fecha          DateTime       @db.Date
  cuerpo         String         @default("")
  archivoId      String?        @unique
  archivo        Archivo?       @relation(fields: [archivoId], references: [id])
  publicadoPorId String
  publicadoPor   User           @relation(fields: [publicadoPorId], references: [id])
  enviadoPorMail Boolean        @default(false)
  /// Orden de los reglamentos (los avisos y actas van por fecha).
  orden          Int            @default(0)
  /// Baja lógica: deja de verse, pero queda la historia.
  activo         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tipo, activo, fecha])
  @@index([edificioId])
  @@map("comunicado")
}

// ---------------------------------------------------------------------------
// Teléfonos y datos de interés (los carga Administración, los ven todos)
// ---------------------------------------------------------------------------

/// Datos de una sola ficha: "ADMINISTRACION" o "PORTERIA". `datos` se valida con Zod (servidor/telefonos.ts).
model FichaContacto {
  edificioId  String
  edificio    Edificio @relation(fields: [edificioId], references: [id])
  clave       String
  datos       Json
  actualizada DateTime @updatedAt

  @@id([edificioId, clave])
  @@map("ficha_contacto")
}

enum TipoContacto {
  COMISION // integrante de la Comisión administradora
  EMPRESA // ascensores, limpieza, sanitaria, bombas…
  SERVICIO // UTE, OSE, saneamiento (datos del recibo, sin montos)
}

model Contacto {
  id                            String       @id @default(cuid())
  edificioId                    String
  edificio                      Edificio     @relation(fields: [edificioId], references: [id])
  tipo                          TipoContacto
  nombre                        String // integrante, empresa o servicio
  detalle                       String       @default("") // cargo, rubro, o qué cubre el servicio
  telefono                      String       @default("")
  unidad                        String       @default("") // integrante de la Comisión: "2-101"
  cuenta                        String       @default("") // servicio: número de cuenta
  titular                       String       @default("") // servicio: titular del recibo
  /// Ley 18.331: un integrante de la Comisión se muestra solo si dio su consentimiento.
  consentimientoEn              DateTime?
  consentimientoRegistradoPorId String?
  consentimientoRegistradoPor   User?        @relation("ConsentimientoRegistradoPor", fields: [consentimientoRegistradoPorId], references: [id])
  orden                         Int          @default(0)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt

  @@index([tipo, orden])
  @@map("contacto")
}

model Poliza {
  id                 String    @id @default(cuid())
  edificioId         String
  edificio           Edificio  @relation(fields: [edificioId], references: [id])
  aseguradora        String
  numero             String
  cobertura          String    @default("")
  desde              DateTime  @db.Date
  hasta              DateTime  @db.Date
  telefono           String    @default("")
  /// Cuándo se avisó por mail a Administración que vence (una vez por vigencia).
  avisoVencimientoEn DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("poliza")
}

// ---------------------------------------------------------------------------
// Emergencias (botón de emergencia, decisión 82)
// ---------------------------------------------------------------------------

enum TipoEmergencia {
  GAS
  INCENDIO
  AGUA
  ASCENSOR
  SEGURIDAD
  OTRA
}

enum EstadoEmergencia {
  ACTIVA
  ATENDIDA
  FALSA_ALARMA
}

/// Aviso de emergencia. Llega a Portería, Administración y Comisión; el aviso a todas
/// las unidades lo manda Portería o Administración después de confirmarlo.
model Emergencia {
  id             String           @id @default(cuid())
  edificioId     String
  edificio       Edificio         @relation(fields: [edificioId], references: [id])
  tipo           TipoEmergencia
  lugar          String           @default("") // "Torre 2, piso 3", "garaje"…
  detalle        String           @default("")
  autorId        String
  autor          User             @relation("EmergenciaAutor", fields: [autorId], references: [id])
  /// Unidad desde la que se avisó (null si avisó Portería, Administración o la Comisión sin unidad).
  unidadId       String?
  unidad         Unidad?          @relation(fields: [unidadId], references: [id])
  estado         EstadoEmergencia @default(ACTIVA)
  creadaEn       DateTime         @default(now())
  /// Aviso a todas las unidades (sin decir quién avisó).
  difundidaEn    DateTime?
  difundidaPorId String?
  difundidaPor   User?            @relation("EmergenciaDifundidaPor", fields: [difundidaPorId], references: [id])
  mensajeGeneral String?
  cerradaEn      DateTime?
  cerradaPorId   String?
  cerradaPor     User?            @relation("EmergenciaCerradaPor", fields: [cerradaPorId], references: [id])
  nota           String?

  @@index([estado, creadaEn])
  @@index([autorId, creadaEn])
  @@index([edificioId])
  @@map("emergencia")
}

// ---------------------------------------------------------------------------
// Pedidos de acceso (decisión 84): quien no tiene usuario lo pide desde el login
// ---------------------------------------------------------------------------

enum EstadoPedidoAcceso {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Lo carga una persona sin sesión; la Administración comprueba que es de esa unidad y
/// lo aprueba (alta + invitación) o lo rechaza.
model PedidoAcceso {
  id            String             @id @default(cuid())
  edificioId    String
  edificio      Edificio           @relation(fields: [edificioId], references: [id])
  nombre        String
  email         String
  telefono      String
  /// Lo que escribió la persona ("2-201"); `unidadId` es la unidad encontrada.
  codigo        String
  unidadId      String
  unidad        Unidad             @relation(fields: [unidadId], references: [id])
  calidad       Calidad
  mensaje       String             @default("")
  estado        EstadoPedidoAcceso @default(PENDIENTE)
  creadoEn      DateTime           @default(now())
  resueltoEn    DateTime?
  resueltoPorId String?
  resueltoPor   User?              @relation("PedidoAccesoResueltoPor", fields: [resueltoPorId], references: [id])
  motivo        String?

  @@index([estado, creadoEn])
  @@index([email, estado])
  @@map("pedido_acceso")
}

// ---------------------------------------------------------------------------
// Edificios (decisión 85): cada uno es independiente (datos, liquidación, cobranza)
// ---------------------------------------------------------------------------

enum EstadoEdificio {
  PENDIENTE // lo pidió un administrador; falta que lo apruebe el dueño del sistema
  ACTIVO
  RECHAZADO
  BAJA
}

model Edificio {
  id            String          @id @default(cuid())
  nombre        String
  direccion     String          @default("")
  estado        EstadoEdificio  @default(ACTIVO)
  /// Módulos prendidos (claves de src/app/(app)/modulos.ts). Vacío = los de siempre.
  modulos       String[]        @default([])
  creadoEn      DateTime        @default(now())
  torres        Torre[]
  unidades      Unidad[]
  configuracion Configuracion?
  liquidaciones Liquidacion[]
  rubros        Rubro[]
  espacios      Espacio[]
  comunicados   Comunicado[]
  fichas        FichaContacto[]
  contactos     Contacto[]
  polizas       Poliza[]
  solicitudes   Solicitud[]
  emergencias   Emergencia[]
  pedidosAcceso PedidoAcceso[]

  @@map("edificio")
}
